<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <LinearLayout
        android:id="@+id/dlgCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:background="@drawable/card_bg"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dlgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_title"
            android:textColor="@color/textMain"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dlgSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/loading"
            android:textColor="@color/textSub"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/dlgScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dlgContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dlgClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/liquid_btn"
                android:minWidth="88dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/close"
                android:textColor="@color/textMain"
                android:textSize="14sp" />

            <Button
                android:id="@+id/dlgAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/liquid_btn_primary"
                android:minWidth="96dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/update_now"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <LinearLayout
        android:id="@+id/dlgCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:background="@drawable/card_bg"
                    android:elevation="18dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dlgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_title"
            android:textColor="@color/textMain"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dlgMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="@color/textSub"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/dlgInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/field_bg"
            android:hint=""
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="@color/textMain"
            android:textColorHint="@color/textSub"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dlgCancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/liquid_btn"
                android:minWidth="88dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/cancel"
                android:textColor="@color/textMain"
                android:textSize="14sp" />

            <Button
                android:id="@+id/dlgOk"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/liquid_btn_primary"
                android:minWidth="88dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/ok"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

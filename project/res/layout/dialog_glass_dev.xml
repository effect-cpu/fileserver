<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <LinearLayout
        android:id="@+id/dlgCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/card_bg"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dlgLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开发者"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dlgHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="@color/textMain"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dlgBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:text=""
            android:textColorLink="@color/colorPrimary"
            android:textColor="@color/textSub"
            android:textSize="15sp" />

        <ScrollView
            android:id="@+id/dlgScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/dlgExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dlgOk"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/liquid_btn_primary"
                android:minWidth="104dp"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="@string/ok"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
